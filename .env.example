# Copy to .env and fill in. NEVER commit the real .env.
# Generate a secret key with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# The subdomain the LMS runs on. Caddy gets the HTTPS certificate for it automatically.
# (Use LMS_DOMAIN=:80 and SECURE_COOKIES=0 only for a quick plain-http test on the server's IP.)
LMS_DOMAIN=lms.gnrrobo.com
DJANGO_ALLOWED_HOSTS=lms.gnrrobo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lms.gnrrobo.com
# Set to 0 only while testing over plain http (no SSL yet)
SECURE_COOKIES=1
WEB_CONCURRENCY=5

POSTGRES_DB=gnr_lms
POSTGRES_USER=gnr
POSTGRES_PASSWORD=change-me-db-password

# ---- Optional: move uploads to AWS S3 later (no code changes needed) ----
# AWS_STORAGE_BUCKET_NAME=gnr-lms-media
# AWS_S3_REGION_NAME=ap-south-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ---- Optional: Bunny Stream for lesson videos (see README → "Lesson videos on Bunny Stream") ----
# BUNNY_STREAM_LIBRARY_ID=123456
# BUNNY_STREAM_API_KEY=library-api-key-from-bunny
# BUNNY_STREAM_TOKEN_KEY=embed-token-authentication-key-from-bunny
# BUNNY_STREAM_EMBED_TTL=14400

# ---- Email for "Forgot password?" links (see README → "Email for password resets") ----
# Without EMAIL_HOST the forgot-password page tells users to ask their instructor/school coordinator,
# and staff reset passwords from the Logins page (works for students with no email).
# Brevo (free 300 emails/day):
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-brevo-smtp-login@smtp-brevo.com
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=GNR Robotics LMS <no-reply@gnrrobo.com>

# ---- Off-server backups (deploy/backup.sh): an rclone remote, see README → Backups ----
# BACKUP_REMOTE=b2:gnr-lms-backups

# ---- Being told when something breaks (README → Knowing when it breaks) ----
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# DJANGO_ADMINS=Your Name <you@example.com>

# ---- Login throttle (defaults shown) ----
# LOGIN_FAILS_PER_USER=10
# LOGIN_FAILS_PER_IP=100
# LOGIN_LOCKOUT_SECONDS=900
