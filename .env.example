# Copy to .env and fill in. NEVER commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=lms.gnrrobotics.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://lms.gnrrobotics.com
# Set to 0 only while testing over plain http (no SSL yet)
SECURE_COOKIES=1
WEB_CONCURRENCY=5

POSTGRES_DB=gnr_lms
POSTGRES_USER=gnr
POSTGRES_PASSWORD=change-me-db-password

# ---- Optional: move uploads to AWS S3 later (no code changes needed) ----
